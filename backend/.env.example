# Get a key at https://serpapi.com (Google Flights engine)
SERPAPI_KEY=your_serpapi_key_here

# Get a key at https://console.anthropic.com (used for AI destination
# suggestions and the AI price-estimate fallback)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Postgres connection string for trip storage. Free serverless Postgres from
# https://neon.tech works well and doesn't expire. Something like:
# postgres://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=your_postgres_connection_string_here

# Optional, defaults to 3000
PORT=3000
